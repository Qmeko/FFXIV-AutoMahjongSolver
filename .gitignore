bin/
obj/
OUTPUT/
artifacts/
*.user
*.suo
.vs/
.idea/
*.DotSettings.user

# Diagnostic dumps from /mjauto findtiles, hexdump, poolslots, poolicons
emj-*.txt
*.rcnet
*_rcnet_data.xml
reflect.txt

# Cloudflare Wrangler local dev cache + Worker npm artifacts (server/)
.wrangler/
server/node_modules/
server/dist/

# Local-only working area: pulled telemetry corpora, analysis artifacts,
# anything containing other users' install IDs or addon memory blobs.
# Never commit — install IDs identify a single install across sessions and
# memory blobs can carry player-name strings.
.local/

# Tuner output (evolutionary / coordinate-descent weight runs).
data/weights/

# Defense-in-depth for credential files. Convention is to keep them under
# .local/secrets.ps1 (already covered above), but a stray .env or .secrets
# anywhere else in the tree should never be tracked either.
.env
*.env
.secrets
*.secrets

# Local one-click build log (regenerated by BUILD_DEBUG_PLUGIN.bat)
/BUILD_DEBUG_PLUGIN.log

# Per-version patch notes. Not used at runtime or by the build.
# Keep THIRD_PARTY_*.txt, ONE_CLICK_BUILD_README_JP.txt, and *VERSION.txt.
/*_FIX_*.txt
/*_FIXES_*.txt
/*_v0.*.txt
/V0.*.txt
/CHANGES_v*.txt
/FIX_v*.txt
